# Cloudflare Workers Static Assets headers (served without invoking the Worker).
# Fingerprinted build output never changes, so cache it for a year.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
# Images, fonts and brand files: a day in browsers, a week at the edge.
/brand/*
  Cache-Control: public, max-age=86400, s-maxage=604800, stale-while-revalidate=86400
/brands/*
  Cache-Control: public, max-age=86400, s-maxage=604800, stale-while-revalidate=86400
/*.webp
  Cache-Control: public, max-age=86400, s-maxage=604800
/*.jpeg
  Cache-Control: public, max-age=86400, s-maxage=604800
/*.jpg
  Cache-Control: public, max-age=86400, s-maxage=604800
/*.png
  Cache-Control: public, max-age=86400, s-maxage=604800
/*.svg
  Cache-Control: public, max-age=86400, s-maxage=604800
# Static seller landing page (public/sell.html): short so edits show up fast.
/sell.html
  Cache-Control: public, max-age=300, s-maxage=3600, stale-while-revalidate=86400
