<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.grayyachts.seo-runs-pull</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/connorgray/Library/Scripts/grayyachts-seo-pull.sh</string>
  </array>
  <!-- Calendar schedule, not StartInterval: launchd runs a missed calendar slot as soon as the Mac wakes. -->
  <key>StartCalendarInterval</key><dict><key>Minute</key><integer>20</integer></dict>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/connorgray/Library/Application Support/GrayYachts/seo-editorial/pull.log</string>
  <key>StandardErrorPath</key><string>/Users/connorgray/Library/Application Support/GrayYachts/seo-editorial/pull-error.log</string>
  <key>ProcessType</key><string>Background</string>
</dict>
</plist>
