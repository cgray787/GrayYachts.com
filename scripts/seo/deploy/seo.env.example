# Gray Yachts SEO editorial agent - environment variable names and safe defaults.
# Copy the lines you need into the real, private env file on the VPS:
#   /opt/grayyachts-automation/private/seo.env
# This file documents variable NAMES ONLY. Never commit a real secret value
# (RESEND_API_KEY, any API key) to this repo.

# --- Provider and research mode -----------------------------------------------
GRAYYACHTS_SEO_PROVIDER=hermes                   # hermes | claude
GRAYYACHTS_SEO_RESEARCH_MODE=official_sources    # web | official_sources | reputable_sources

# --- Hermes CLI ------------------------------------------------------------------
GRAYYACHTS_SEO_HERMES_BIN=/usr/local/bin/hermes  # default: shutil.which('hermes') or /usr/local/bin/hermes
GRAYYACHTS_SEO_HERMES_PROVIDER=codex             # --provider flag passed to `hermes chat`

# --- Model override (optional) --------------------------------------------------
# GRAYYACHTS_SEO_MODEL=                          # unset = no --model flag passed to hermes/claude

# --- Pre-run auth/login health check --------------------------------------------
# GRAYYACHTS_SEO_AUTH_CHECK=                     # override the whole check command, shlex-split;
                                                  # default is provider specific (hermes/claude auth status)

# --- Timeouts --------------------------------------------------------------------
GRAYYACHTS_SEO_CLI_TIMEOUT=900                   # seconds given to the research/draft CLI call

# --- State and alerts ------------------------------------------------------------
GRAYYACHTS_SEO_STATE=/opt/grayyachts-automation/private/seo-editorial
GRAYYACHTS_SEO_ALERT_TO=connorgray@jeffbrownyachts.com
# onboarding@resend.dev is Resend's shared sandbox sender: it only delivers to the
# Resend account owner's own inbox. Move this to a verified sending domain before
# this alert needs to reach anyone other than the account owner.
GRAYYACHTS_SEO_ALERT_FROM=Gray Yachts SEO Agent <onboarding@resend.dev>

# RESEND_API_KEY=                                # secret; set in the real private env file, never here
