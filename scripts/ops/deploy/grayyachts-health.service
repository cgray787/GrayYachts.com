[Unit]
Description=Gray Yachts automation daily health email
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Git credential helpers resolve the machine-local root configuration through HOME.
Environment=HOME=/root
ExecStart=/usr/bin/python3 /opt/grayyachts-health/vps_health.py
TimeoutStartSec=600
