x] text-text-secondary\" aria-hidden=\"true\"><path d=\"M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z\"></path><path d=\"M14 2v5a1 1 0 0 0 1 1h5\"></path><path d=\"M10 9H8\"></path><path d=\"M16 13H8\"></path><path d=\"M16 17H8\"></path></svg>Documents</a></li><li><a class=\"flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium transition-colors bg-gold-muted text-white\" href=\"/portal/maintenance\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-wrench h-[18px] w-[18px] text-gold\" aria-hidden=\"true\"><path d=\"M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.106-3.105c.32-.322.863-.22.983.218a6 6 0 0 1-8.259 7.057l-7.91 7.91a1 1 0 0 1-2.999-3l7.91-7.91a6 6 0 0 1 7.057-8.259c.438.12.54.662.219.984z\"></path></svg>Maintenance</a></li><li><button class=\"flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium transition-colors text-text-secondary hover:bg-bg-card hover:text-text-primary\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-briefcase h-[18px] w-[18px] text-text-secondary\" aria-hidden=\"true\"><path d=\"M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16\"></path><rect width=\"20\" height=\"14\" x=\"2\" y=\"6\" rx=\"2\"></rect></svg><span class=\"flex-1 text-left\">Services</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-right h-4 w-4 text-text-secondary\" aria-hidden=\"true\"><path d=\"m9 18 6-6-6-6\"></path></svg></button></li></ul></nav><div class=\"border-t border-border px-4 py-4\"><div class=\"flex items-center gap-3\"><div class=\"flex h-9 w-9 items-center justify-center rounded-full bg-gold-muted text-sm font-semibold text-gold\">JD</div><div class=\"min-w-0 flex-1\"><p class=\"truncate text-sm font-medium text-text-primary\">James Donovan</p><p class=\"truncate text-xs text-text-secondary\">james@donovan.com</p></div></div></div></aside><main class=\"ml-60 flex-1 overflow-y-auto p-8\"><div class=\"mx-auto max-w-7xl\"><div class=\"mb-8 flex items-start justify-between\"><div><h1 class=\"font-[family-name:var(--font-cormorant)] text-3xl font-semibold text-text-primary\">Maintenance Records</h1><p class=\"mt-1 text-sm text-text-secondary\">Track all service history, invoices, and receipts for your vessel</p></div><div class=\"flex items-center gap-3\"><button class=\"flex items-center gap-2 rounded-lg border border-border bg-bg-card px-4 py-2.5 text-sm text-text-secondary transition-colors hover:bg-bg-card-hover hover:text-text-primary\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-sliders-horizontal h-4 w-4\" aria-hidden=\"true\"><path d=\"M10 5H3\"></path><path d=\"M12 19H3\"></path><path d=\"M14 3v4\"></path><path d=\"M16 17v4\"></path><path d=\"M21 12h-9\"></path><path d=\"M21 19h-5\"></path><path d=\"M21 5h-7\"></path><path d=\"M8 10v4\"></path><path d=\"M8 12H3\"></path></svg>Filter</button><button class=\"flex items-center gap-2 rounded-lg border border-border bg-bg-card px-4 py-2.5 text-sm text-text-secondary transition-colors hover:bg-bg-card-hover hover:text-text-primary\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-up-down h-4 w-4\" aria-hidden=\"true\"><path d=\"m21 16-4 4-4-4\"></path><path d=\"M17 20V4\"></path><path d=\"m3 8 4-4 4 4\"></path><path d=\"M7 4v16\"></path></svg>Sort by Date</button></div></div><div class=\"mb-8 flex flex-col items-center justify-center rounded-xl border-2 border-dashed px-6 py-12 text-center transition-colors border-border bg-bg-card/50\"><div class=\"mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-blue-400/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-upload h-6 w-6 text-blue-400\" aria-hidden=\"true\"><path d=\"M12 3v12\"></path><path d=\"m17 8-5-5-5 5\"></path><path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"></path></svg></div><p class=\"text-lg font-medium text-text-primary\">Drag &amp; Drop Maintenance Records Here</p><p class=\"mt-1 max-w-md text-sm text-text-secondary\">Upload invoices, receipts, service reports, and photos. Supports PDF, JPG, PNG</p><div class=\"mt-5 flex items-center gap-3\"><button class=\"flex items-center gap-2 rounded-lg bg-gold px-5 py-2.5 text-sm font-medium text-bg-primary transition-colors hover:bg-gold-hover\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-folder-open h-4 w-4\" aria-hidden=\"true\"><path d=\"m6 14 1.5-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.54 6a2 2 0 0 1-1.95 1.5H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H18a2 2 0 0 1 2 2v2\"></path></svg>Browse Files</button><span class=\"text-sm text-text-secondary\">or drop files above</span></div></div><div class=\"mb-8 grid grid-cols-4 gap-5\"><div class=\"rounded-xl border border-border bg-bg-card p-5\"><div class=\"mb-3 flex items-center justify-between\"><div class=\"flex h-10 w-10 items-center justify-center rounded-lg bg-blue-400/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-file-text h-5 w-5 text-blue-400\" aria-hidden=\"true\"><path d=\"M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z\"></path><path d=\"M14 2v5a1 1 0 0 0 1 1h5\"></path><path d=\"M10 9H8\"></path><path d=\"M16 13H8\"></path><path d=\"M16 17H8\"></path></svg></div></div><p class=\"text-2xl font-semibold text-text-primary\">24</p><p class=\"mt-0.5 text-sm text-text-secondary\">Total Records</p></div><div class=\"rounded-xl border border-border bg-bg-card p-5\"><div class=\"mb-3 flex items-center justify-between\"><div class=\"flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-400/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-calendar-days h-5 w-5 text-emerald-400\" aria-hidden=\"true\"><path d=\"M8 2v4\"></path><path d=\"M16 2v4\"></path><rect width=\"18\" height=\"18\" x=\"3\" y=\"4\" rx=\"2\"></rect><path d=\"M3 10h18\"></path><path d=\"M8 14h.01\"></path><path d=\"M12 14h.01\"></path><path d=\"M16 14h.01\"></path><path d=\"M8 18h.01\"></path><path d=\"M12 18h.01\"></path><path d=\"M16 18h.01\"></path></svg></div></div><p class=\"text-2xl font-semibold text-text-primary\">3</p><p class=\"mt-0.5 text-sm text-text-secondary\">Upcoming</p></div><div class=\"rounded-xl border border-border bg-bg-card p-5\"><div class=\"mb-3 flex items-center justify-between\"><div class=\"flex h-10 w-10 items-center justify-center rounded-lg bg-yellow-400/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-triangle-alert h-5 w-5 text-yellow-400\" aria-hidden=\"true\"><path d=\"m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3\"></path><path d=\"M12 9v4\"></path><path d=\"M12 17h.01\"></path></svg></div></div><p class=\"text-2xl font-semibold text-red-400\">1</p><p class=\"mt-0.5 text-sm text-text-secondary\">Overdue</p></div><div class=\"rounded-xl border border-border bg-bg-card p-5\"><div class=\"mb-3 flex items-center justify-between\"><div class=\"flex h-10 w-10 items-center justify-center rounded-lg bg-purple-400/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-dollar-sign h-5 w-5 text-purple-400\" aria-hidden=\"true\"><line x1=\"12\" x2=\"12\" y1=\"2\" y2=\"22\"></line><path d=\"M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6\"></path></svg></div></div><p class=\"text-2xl font-semibold text-text-primary\">$12,450</p><p class=\"mt-0.5 text-sm text-text-secondary\">Total Spent YTD</p></div></div><div class=\"mb-8 flex items-center gap-1 overflow-x-auto rounded-xl border border-border bg-bg-card p-1.5\"><button class=\"flex shrink-0 items-center gap-2 rounded-lg px-4 py-2 text-sm font-medium transition-colors bg-gold-muted text-gold\">All Records<span class=\"flex h-5 min-w-5 items-center justify-center rounded-full px-1.5 text-[11px] font-semibold bg-gold/20 text-gold\">24</span></button><button class=\"flex shrink-0 items-center gap-2 rounded-lg px-4 py-2 text-sm font-medium transition-colors text-text-secondary hover:bg-bg-card-hover hover:text-text-primary\">Engine</button><button class=\"flex shrink-0 items-center gap-2 rounded-lg px-4 py-2 text-sm font-medium transition-colors text-text-secondary hover:bg-bg-card-hover hover:text-text-primary\">Hull &amp; Paint</button><button class=\"flex shrink-0 items-center gap-2 rounded-lg px-4 py-2 text-sm font-medium transition-colors text-text-secondary hover:bg-bg-card-hover hover:text-text-primary\">Electrical</button><button class=\"flex shrink-0 items-center gap-2 rounded-lg px-4 py-2 text-sm font-medium transition-colors text-text-secondary hover:bg-bg-card-hover hover:text-text-primary\">Rigging</button><button class=\"flex shrink-0 items-center gap-2 rounded-lg px-4 py-2 text-sm font-medium transition-colors text-text-secondary hover:bg-bg-card-hover hover:text-text-primary\">Cleaning</button><button class=\"flex shrink-0 items-center gap-2 rounded-lg px-4 py-2 text-sm font-medium transition-colors text-text-secondary hover:bg-bg-card-hover hover:text-text-primary\">Annual Survey</button></div><div class=\"space-y-10\"><section><div class=\"mb-4 flex items-center gap-2.5\"><span class=\"h-2.5 w-2.5 rounded-full bg-gold\"></span><h2 class=\"font-[family-name:var(--font-cormorant)] text-xl font-semibold text-text-primary\">March 2026</h2></div><div class=\"space-y-4\"><div class=\"overflow-hidden rounded-xl border border-border bg-bg-card transition-colors\"><div class=\"flex\"><div class=\"flex-1 p-5\"><div class=\"mb-2 flex items-center gap-2\"><span class=\"rounded-full px-2.5 py-0.5 text-[11px] font-medium bg-orange-500/20 text-orange-400\">Engine</span><span class=\"ml-auto text-xs text-text-secondary\">Mar 1, 2026 · 10:30 AM</span></div><h3 class=\"text-base font-semibold text-text-primary\">Oil Change &amp; Filter Replacement — Twin Volvo D6</h3><p class=\"mt-1 text-sm leading-relaxed text-text-secondary\">Full oil and filter change on both engines. Replaced fuel filters and checked impellers. All systems running within spec.</p><div class=\"mt-4 flex items-center gap-5 text-xs text-text-secondary\"><span class=\"flex items-center gap-1.5\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-wrench h-3.5 w-3.5\" aria-hidden=\"true\"><path d=\"M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.106-3.105c.32-.322.863-.22.983.218a6 6 0 0 1-8.259 7.057l-7.91 7.91a1 1 0 0 1-2.999-3l7.91-7.91a6 6 0 0 1 7.057-8.259c.438.12.54.662.219.984z\"></path></svg>Derik Swenson</span><span class=\"flex items-center gap-1.5\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-dollar-sign h-3.5 w-3.5\" aria-hidden=\"true\"><line x1=\"12\" x2=\"12\" y1=\"2\" y2=\"22\"></line><path d=\"M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6\"></path></svg>$1,240.00</span></div></div><div class=\"flex w-52 shrink-0 flex-col items-center justify-center border-l border-border bg-bg-secondary/50 p-5\"><div class=\"mb-2 flex h-12 w-12 items-center justify-center rounded-lg bg-bg-card\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-file-text h-6 w-6 text-text-secondary\" aria-hidden=\"true\"><path d=\"M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z\"></path><path d=\"M14 2v5a1 1 0 0 0 1 1h5\"></path><path d=\"M10 9H8\"></path><path d=\"M16 13H8\"></path><path d=\"M16 17H8\"></path></svg></div><p class=\"mb-0.5 text-xs font-medium text-text-primary\">Invoice_0312.pdf</p><p class=\"mb-3 text-[11px] text-text-secondary\">240 KB</p><button class=\"rounded-lg border border-border bg-bg-card px-4 py-2 text-xs font-medium text-text-primary transition-colors hover:bg-bg-card-hover\">View Invoice</button></div></div></div><div class=\"overflow-hidden rounded-xl border bor