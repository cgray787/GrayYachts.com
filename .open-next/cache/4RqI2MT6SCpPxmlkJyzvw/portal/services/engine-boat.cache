ucide lucide-file-text h-[18px] w-[18px] text-text-secondary\" aria-hidden=\"true\"><path d=\"M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z\"></path><path d=\"M14 2v5a1 1 0 0 0 1 1h5\"></path><path d=\"M10 9H8\"></path><path d=\"M16 13H8\"></path><path d=\"M16 17H8\"></path></svg>Documents</a></li><li><a class=\"flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium transition-colors text-text-secondary hover:bg-bg-card hover:text-text-primary\" href=\"/portal/maintenance\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-wrench h-[18px] w-[18px] text-text-secondary\" aria-hidden=\"true\"><path d=\"M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.106-3.105c.32-.322.863-.22.983.218a6 6 0 0 1-8.259 7.057l-7.91 7.91a1 1 0 0 1-2.999-3l7.91-7.91a6 6 0 0 1 7.057-8.259c.438.12.54.662.219.984z\"></path></svg>Maintenance</a></li><li><button class=\"flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium transition-colors bg-gold-muted text-white\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-briefcase h-[18px] w-[18px] text-gold\" aria-hidden=\"true\"><path d=\"M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16\"></path><rect width=\"20\" height=\"14\" x=\"2\" y=\"6\" rx=\"2\"></rect></svg><span class=\"flex-1 text-left\">Services</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down h-4 w-4 text-text-secondary\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button><ul class=\"mt-1 ml-[30px] space-y-0.5 border-l border-border pl-3\"><li><a class=\"block rounded-md px-3 py-2 text-[13px] transition-colors text-text-secondary hover:text-text-primary\" href=\"/portal/services/insurance\">Insurance</a></li><li><a class=\"block rounded-md px-3 py-2 text-[13px] transition-colors text-text-secondary hover:text-text-primary\" href=\"/portal/services/captain-crew\">Captain &amp; Crew</a></li><li><a class=\"block rounded-md px-3 py-2 text-[13px] transition-colors text-text-secondary hover:text-text-primary\" href=\"/portal/services/berth-marina\">Berth &amp; Marina</a></li><li><a class=\"block rounded-md px-3 py-2 text-[13px] transition-colors text-gold\" href=\"/portal/services/engine-boat\">Engine &amp; Boat Service</a></li></ul></li></ul></nav><div class=\"border-t border-border px-4 py-4\"><div class=\"flex items-center gap-3\"><div class=\"flex h-9 w-9 items-center justify-center rounded-full bg-gold-muted text-sm font-semibold text-gold\">JD</div><div class=\"min-w-0 flex-1\"><p class=\"truncate text-sm font-medium text-text-primary\">James Donovan</p><p class=\"truncate text-xs text-text-secondary\">james@donovan.com</p></div></div></div></aside><main class=\"ml-60 flex-1 overflow-y-auto p-8\"><div class=\"mx-auto max-w-7xl\"><div class=\"mb-6\"><div class=\"flex items-center gap-2 text-sm\"><a class=\"text-gold transition-colors hover:text-gold-hover\" href=\"/portal/services\">Services</a><span class=\"text-text-secondary\">/</span><span class=\"text-gold\">Engine &amp; Boat Service</span></div></div><div class=\"mb-8\"><h1 class=\"font-[family-name:var(--font-cormorant)] text-3xl font-semibold text-text-primary\">Engine &amp; Boat Service</h1><p class=\"mt-2 text-sm text-text-secondary\">Expert marine technicians and specialists available for all your vessel maintenance and repair needs. Mobile service available throughout the Puget Sound region.</p></div><div class=\"mb-8 rounded-xl border border-border bg-bg-card p-6\"><div class=\"flex flex-col items-center gap-6 md:flex-row md:items-start\"><div class=\"flex h-24 w-24 flex-shrink-0 items-center justify-center rounded-full bg-bg-secondary text-xl font-semibold text-text-secondary\">DS</div><div class=\"flex-1 text-center md:text-left\"><div class=\"flex flex-wrap items-center justify-center gap-3 md:justify-start\"><h2 class=\"text-xl font-semibold text-text-primary\">Derik Swenson</h2><span class=\"rounded-full bg-emerald-400/15 px-3 py-1 text-xs font-medium text-emerald-400\">Lead Technician</span></div><p class=\"mt-1 text-sm font-medium text-gold\">Mobile Engine &amp; Boat Technician</p><p class=\"mt-3 text-sm leading-relaxed text-text-secondary\">Providing mobile engine diagnostics, repair, and maintenance services throughout the Puget Sound region. Factory-trained on major inboard and outboard engine brands including Volvo Penta, Cummins, Caterpillar, Yamaha, and Mercury. Specializing in diesel engine systems, fuel injection, electrical troubleshooting, and seasonal winterization.</p><div class=\"mt-4 flex flex-wrap justify-center gap-4 md:justify-start\"><div class=\"flex items-center gap-2 text-sm text-text-secondary\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-phone h-3.5 w-3.5\" aria-hidden=\"true\"><path d=\"M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384\"></path></svg>(206) 555-0478</div><div class=\"flex items-center gap-2 text-sm text-text-secondary\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-mail h-3.5 w-3.5\" aria-hidden=\"true\"><path d=\"m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7\"></path><rect x=\"2\" y=\"4\" width=\"20\" height=\"16\" rx=\"2\"></rect></svg>derik@pnwmarine.com</div></div></div></div></div><div class=\"mb-8\"><h2 class=\"mb-5 font-[family-name:var(--font-cormorant)] text-xl font-semibold text-text-primary\">Service Specialists</h2><div class=\"grid grid-cols-1 gap-5 md:grid-cols-2\"><div class=\"flex items-start gap-4 rounded-xl border border-border bg-bg-card p-5\"><div class=\"flex h-14 w-14 flex-shrink-0 items-center justify-center rounded-full bg-bg-secondary text-sm font-semibold text-text-secondary\">TR</div><div class=\"flex-1\"><h3 class=\"font-medium text-text-primary\">Tony Reeves</h3><p class=\"mt-0.5 text-sm font-medium text-gold\">Fiberglass Specialist</p><p class=\"mt-2 text-sm leading-relaxed text-text-secondary\">Expert gelcoat and fiberglass repair, structural reinforcement, blister repair, and custom fabrication.</p></div></div><div class=\"flex items-start gap-4 rounded-xl border border-border bg-bg-card p-5\"><div class=\"flex h-14 w-14 flex-shrink-0 items-center justify-center rounded-full bg-bg-secondary text-sm font-semibold text-text-secondary\">CM</div><div class=\"flex-1\"><h3 class=\"font-medium text-text-primary\">Carlos Medina</h3><p class=\"mt-0.5 text-sm font-medium text-gold\">Painting Specialist</p><p class=\"mt-2 text-sm leading-relaxed text-text-secondary\">Professional hull painting, Awlgrip topside refinishing, anti-fouling bottom paint, and custom graphics.</p></div></div><div class=\"flex items-start gap-4 rounded-xl border border-border bg-bg-card p-5\"><div class=\"flex h-14 w-14 flex-shrink-0 items-center justify-center rounded-full bg-bg-secondary text-sm font-semibold text-text-secondary\">MB</div><div class=\"flex-1\"><h3 class=\"font-medium text-text-primary\">Marcus Bell</h3><p class=\"mt-0.5 text-sm font-medium text-gold\">Hull Cleaning Specialist</p><p class=\"mt-2 text-sm leading-relaxed text-text-secondary\">Underwater hull cleaning, zinc replacement, propeller service, and through-hull inspection. Eco-friendly methods.</p></div></div><div class=\"flex items-start gap-4 rounded-xl border border-border bg-bg-card p-5\"><div class=\"flex h-14 w-14 flex-shrink-0 items-center justify-center rounded-full bg-bg-secondary text-sm font-semibold text-text-secondary\">AP</div><div class=\"flex-1\"><h3 class=\"font-medium text-text-primary\">Amanda Park</h3><p class=\"mt-0.5 text-sm font-medium text-gold\">Detail Cleaning Specialist</p><p class=\"mt-2 text-sm leading-relaxed text-text-secondary\">Premium interior and exterior detailing, teak restoration, canvas care, stainless polishing, and ceramic coating.</p></div></div></div></div><div class=\"flex justify-center\"><button class=\"flex items-center gap-2 rounded-lg bg-gold px-6 py-3 text-sm font-semibold text-bg-primary transition-colors hover:bg-gold-hover\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-wrench h-4 w-4\" aria-hidden=\"true\"><path d=\"M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.106-3.105c.32-.322.863-.22.983.218a6 6 0 0 1-8.259 7.057l-7.91 7.91a1 1 0 0 1-2.999-3l7.91-7.91a6 6 0 0 1 7.057-8.259c.438.12.54.662.219.984z\"></path></svg>Schedule Service</button></div></div><!--$--><!--/$--></main></div><script src=\"/_next/static/chunks/2f508c16950a19d4.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[39756,[\\\"/_next/static/chunks/ff1a16fafef87110.js\\\",\\\"/_next/static/chunks/d2be314c3ece3fbe.js\\\"],\\\"default\\\"]\\n3:I[37457,[\\\"/_next/static/chunks/ff1a16fafef87110.js\\\",\\\"/_next/static/chunks/d2be314c3ece3fbe.js\\\"],\\\"default\\\"]\\n4:I[49512,[\\\"/_next/static/chunks/2d85ae714e4134