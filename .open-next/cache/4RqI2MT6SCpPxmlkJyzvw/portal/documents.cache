between\"><div class=\"flex h-10 w-10 items-center justify-center rounded-lg bg-blue-400/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-folder-open h-5 w-5 text-blue-400\" aria-hidden=\"true\"><path d=\"m6 14 1.5-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.54 6a2 2 0 0 1-1.95 1.5H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H18a2 2 0 0 1 2 2v2\"></path></svg></div></div><p class=\"text-2xl font-semibold text-text-primary\">18</p><p class=\"mt-0.5 text-sm text-text-secondary\">Total Documents</p></div><div class=\"rounded-xl border border-border bg-bg-card p-5\"><div class=\"mb-3 flex items-center justify-between\"><div class=\"flex h-10 w-10 items-center justify-center rounded-lg bg-gold-muted\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield h-5 w-5 text-gold\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path></svg></div></div><p class=\"text-2xl font-semibold text-text-primary\">6</p><p class=\"mt-0.5 text-sm text-text-secondary\">Certificates</p></div><div class=\"rounded-xl border border-border bg-bg-card p-5\"><div class=\"mb-3 flex items-center justify-between\"><div class=\"flex h-10 w-10 items-center justify-center rounded-lg bg-blue-400/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-dot h-5 w-5 text-blue-400\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><circle cx=\"12\" cy=\"12\" r=\"1\"></circle></svg></div></div><p class=\"text-2xl font-semibold text-text-primary\">4</p><p class=\"mt-0.5 text-sm text-text-secondary\">Coast Guard</p></div><div class=\"rounded-xl border border-border bg-bg-card p-5\"><div class=\"mb-3 flex items-center justify-between\"><div class=\"flex h-10 w-10 items-center justify-center rounded-lg bg-red-400/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-alert h-5 w-5 text-red-400\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><line x1=\"12\" x2=\"12\" y1=\"8\" y2=\"12\"></line><line x1=\"12\" x2=\"12.01\" y1=\"16\" y2=\"16\"></line></svg></div></div><p class=\"text-2xl font-semibold text-red-400\">2</p><p class=\"mt-0.5 text-sm text-text-secondary\">Expiring Soon</p></div></div><div class=\"mb-8 flex items-center gap-1 overflow-x-auto rounded-xl border border-border bg-bg-card p-1.5\"><button class=\"flex shrink-0 items-center gap-2 rounded-lg px-4 py-2 text-sm font-medium transition-colors bg-gold-muted text-gold\">All Documents<span class=\"flex h-5 min-w-5 items-center justify-center rounded-full px-1.5 text-[11px] font-semibold bg-gold/20 text-gold\">18</span></button><button class=\"flex shrink-0 items-center gap-2 rounded-lg px-4 py-2 text-sm font-medium transition-colors text-text-secondary hover:bg-bg-card-hover hover:text-text-primary\">Certificates</button><button class=\"flex shrink-0 items-center gap-2 rounded-lg px-4 py-2 text-sm font-medium transition-colors text-text-secondary hover:bg-bg-card-hover hover:text-text-primary\">Registration</button><button class=\"flex shrink-0 items-center gap-2 rounded-lg px-4 py-2 text-sm font-medium transition-colors text-text-secondary hover:bg-bg-card-hover hover:text-text-primary\">Owner Manuals<