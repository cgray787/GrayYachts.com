{
  "manifest_version": 3,
  "name": "Gray Yachts \u2014 Facebook CRM Bridge",
  "version": "1.1.0",
  "description": "Read-only import of visible Messenger conversations into the Gray Yachts FB CRM.",
  "permissions": [
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://web.facebook.com/*",
    "https://grayyachts.com/*",
    "https://www.grayyachts.com/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://grayyachts.com/portal/*",
        "https://www.grayyachts.com/portal/*",
        "http://localhost/portal/*"
      ],
      "js": [
        "content-portal.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.facebook.com/marketplace/item/*",
        "https://web.facebook.com/marketplace/item/*",
        "https://www.facebook.com/messages/*",
        "https://web.facebook.com/messages/*"
      ],
      "js": [
        "content-fb.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
