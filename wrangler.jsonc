{
  "name": "grayyachts-com",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://eorkwxzhtidstznpzlyg.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImVvcmt3eHpodGlkc3R6bnB6bHlnIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzM5NzA3MzAsImV4cCI6MjA4OTU0NjczMH0.2mPq25_musLoqHLZCzzLFjj_70fcNs5nYwJd9H94aEE",
    "MARINE_TECH_SUPABASE_URL": "https://ikfcnqdrlvhvlyhiuphs.supabase.co"
  },
  "routes": [
    { "pattern": "grayyachts.com/*", "zone_name": "grayyachts.com" },
    { "pattern": "www.grayyachts.com/*", "zone_name": "grayyachts.com" }
  ],
  // Cloudflare's built-in rate limiter, shared across isolates. An in-process
  // Map does NOT work here — Workers spreads requests over many isolates, so a
  // per-isolate counter never accumulates (verified: 7 rapid posts, no 429).
  // Guards the public unauthenticated POST /api/inquiry.
  "unsafe": {
    "bindings": [
      {
        "name": "INQUIRY_RATE_LIMIT",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 5, "period": 60 }
      }
    ]
  }
}
