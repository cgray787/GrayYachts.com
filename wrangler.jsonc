{
  "name": "grayyachts-com",
  "main": "newsletter-worker.ts",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "ai": { "binding": "AI" },
  // Resizes newsletter media (src/lib/newsletter/resize.ts); /cdn-cgi/image is not enabled on the zone.
  "images": { "binding": "IMAGES" },
  "triggers": { "crons": ["0 * * * *"] },
  "d1_databases": [{ "binding": "NEWSLETTER_DB", "database_name": "grayyachts-newsletter", "database_id": "587d73f8-45f4-4eb0-9490-984266d025c3", "migrations_dir": "migrations/newsletter" }],
  "r2_buckets": [{ "binding": "YACHT_PHOTOS", "bucket_name": "grayyachts-catalog-photos" }],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NEWSLETTER_AI_PROVIDER": "hermes",
    "NEWSLETTER_REVIEW_TO": "connorgray@jeffbrownyachts.com",
    "NEWSLETTER_FROM": "Gray Yachts <onboarding@resend.dev>",
    "NEWSLETTER_START_DATE": "2026-09-08",
    "NEXT_PUBLIC_SUPABASE_URL": "https://eorkwxzhtidstznpzlyg.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImVvcmt3eHpodGlkc3R6bnB6bHlnIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzM5NzA3MzAsImV4cCI6MjA4OTU0NjczMH0.2mPq25_musLoqHLZCzzLFjj_70fcNs5nYwJd9H94aEE",
    "MARINE_TECH_SUPABASE_URL": "https://ikfcnqdrlvhvlyhiuphs.supabase.co"
  },
  "routes": [
    { "pattern": "grayyachts.com/*", "zone_name": "grayyachts.com" },
    { "pattern": "www.grayyachts.com/*", "zone_name": "grayyachts.com" }
  ],
  // RATE_LIMIT KV: newsletter stall-alert state. It also used to count /api/inquiry,
  // which now uses the RATE_LIMITER Durable Object below. History of that limiter:
  //  - the `ratelimit` binding resolves and is invoked, but was never observed
  //    enforcing (beta / likely plan-gated) — kept as a free fast path;
  //  - KV is the one that actually counts. An in-process Map does NOT work:
  //    Workers spreads requests across isolates so a per-isolate counter never
  //    accumulates (verified — 7 rapid posts produced no 429).
  "kv_namespaces": [
    { "binding": "RATE_LIMIT", "id": "ce1e84923c4f469d8420906f9185be8c" }
  ],
  // Atomic per-IP quota for the public cost/write API routes (src/lib/rate-limit.ts).
  // KV could not do this: it is not atomic and allows one write per key per second,
  // so a concurrent burst passed straight through. SQLite-backed because that is the
  // Durable Object class type the Workers Free plan supports. The class is exported
  // from newsletter-worker.ts; the first deploy applies migration v1-rate-limiter.
  "durable_objects": {
    "bindings": [{ "name": "RATE_LIMITER", "class_name": "RateLimiterDO" }]
  },
  "migrations": [{ "tag": "v1-rate-limiter", "new_sqlite_classes": ["RateLimiterDO"] }],
  "unsafe": {
    "bindings": [
      {
        "name": "INQUIRY_RATE_LIMIT",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 5, "period": 60 }
      }
    ]
  }
}
